@using Microsoft.AspNetCore.Identity;

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if(SignInManager.IsSignedIn(User))
{
    <a class="text-black-50 text-decoration-none small fw-medium">
       <i class="bi bi-person-circle me-1"></i>@UserManager.GetUserName(User)
    </a>
    <form method="post" asp-area="Identity" asp-controller="Account" asp-action="Logout">
        <button type="submit" class="btn btn-sm btn-warning"
            style="font-size: 0.7rem; letter-spacing:0.005em; text-transform: uppercase"
            >
                Logout
        </button>
    </form>
}
else
{
    <a class="btn btn-sm btn-info fw-semibold" asp-area="Identity" asp-controller="Account" asp-action="Register">
        Register
    </a>

    <a class="btn btn-sm btn-accent fw-semibold" asp-area="Identity" asp-controller="Account" asp-action="Login">
        Login
    </a>
}

